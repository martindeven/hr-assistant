# Variables del HR Assistant. Copia este archivo y llena tus valores fuera del
# repositorio. Nunca subas un token ni un id de cuenta reales.

# Modelo: fake (simulado, sin red) o gateway (Cloudflare Workers AI por AI Gateway)
MODEL_PROVIDER=fake

# Cloudflare: obligatorias con MODEL_PROVIDER=gateway. El token es secreto.
CF_ACCOUNT_ID=
CF_GATEWAY_ID=default
CF_API_TOKEN=

# Modelos y palancas de costo
MODEL_SMALL=@cf/meta/llama-3.1-8b-instruct-fast
MODEL_LARGE=@cf/meta/llama-3.3-70b-instruct-fp8-fast
ROUTING=true
ROUTER_MAX_CHARS=80
HISTORY_WINDOW=6
MODEL_MAX_TOKENS=300
MODEL_TEMPERATURE=0
CACHE_TTL_SECONDS=0
PRICES_PATH=data/model_prices.json

# Agente y topes de la petición
AGENT_MAX_STEPS=3
MAX_QUESTION_CHARS=2000
MAX_HISTORY_MESSAGES=20
MAX_HISTORY_CHARS=4000
EMPLOYEES_PATH=data/employees.json

# Observabilidad
SERVICE_NAME=hr-assistant
SLO_P95_MS=2000
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
HIDE_INPUTS=true
HIDE_OUTPUTS=true

# Producción y acceso. Con ENVIRONMENT=production se aplican las reglas de
# compliance (ver doc/compliance-checklist.md).
ENVIRONMENT=development
# Clientes y claves con la forma cliente:clave,cliente2:clave2. Es secreto:
# déjala vacía aquí. Vacía, POST /ask y GET /metrics responden 401.
API_KEYS=
RATE_LIMIT_PER_MINUTE=30

# Reto, parte 1: multiagente, concurrencia y resiliencia
POLICIES_PATH=data/policies.json
# Procesos de uvicorn en el contenedor (cada uno con sus métricas y su límite)
WEB_CONCURRENCY=2
MODEL_RETRIES=2
MODEL_RETRY_BACKOFF_MS=200
MODEL_FALLBACK=true
MODEL_TIMEOUT_SECONDS=30

# Reto, parte 1: seguridad en capas
# Datos personales en la entrada: redact (los tapa), block (responde 400) u off.
# En producción off no está permitido.
PII_INPUT_MODE=redact
# Bloquea la inyección de instrucciones con 400. En producción debe ser true.
INJECTION_GUARD=true
MAX_ANSWER_CHARS=1500
# Un cuerpo más grande responde 413 sin leerse completo.
MAX_BODY_BYTES=65536
# Permisos por cliente: cliente:directory policies metrics,cliente2:policies.
# Permisos: directory, policies y metrics. Cada cliente debe estar en API_KEYS.
# En development, un cliente sin entrada tiene todos los permisos; en
# production cada cliente de API_KEYS necesita su entrada o no arranca.
# Nombra a los clientes: no la subas con valores reales.
API_KEY_SCOPES=
